{
  "name": "qanoontech-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Control plane for a QanoonTech deployment",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "qanoontech-engine": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "engine": "tsx src/cli.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ui": "npm --prefix ui run build",
    "build:all": "npm run build && npm run build:ui"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "commander": "^14.0.0",
    "fastify": "^5.12.1",
    "paseto": "^3.1.4",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
